set -euo pipefail

if command -v mdl >/dev/null 2>&1; then
  exec mdl --rules MD034 "$@"
fi

MDL_DIR="${HOME}/.cache/gcpdiag-mdl"
if [ ! -x "${MDL_DIR}/bin/mdl" ]; then
  mkdir -p "${MDL_DIR}"
  cat << 'EOF' > "${MDL_DIR}/Gemfile"
source "https://rubygems.org"
gem "tomlrb", "2.0.4"
gem "mdl", "0.13.0"
EOF
  GEM_HOME="${MDL_DIR}" GEM_PATH="${MDL_DIR}" gem install \
    --no-document \
    --no-user-install \
    --no-lock \
    --install-dir "${MDL_DIR}" \
    --bindir "${MDL_DIR}/bin" \
    -g "${MDL_DIR}/Gemfile"
fi

exec env GEM_HOME="${MDL_DIR}" GEM_PATH="${MDL_DIR}" "${MDL_DIR}/bin/mdl" --rules MD034 "$@"
